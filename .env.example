# PostgreSQL (production)
# Render provides this automatically when DATABASE_URL is linked to a Postgres database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/campuscart

# Local SQLite fallback (only used when DATABASE_URL is empty)
CAMPUS_DB_PATH=campuscart.db
CAMPUS_SECRET_KEY=replace-with-a-long-random-secret
CAMPUS_BASE_URL=http://127.0.0.1:5000
FLASK_ENV=development

# Payments - leave test values for development and configure production credentials later
ESEWA_ENV=uat
ESEWA_PRODUCT_CODE=EPAYTEST
ESEWA_SECRET_KEY=replace-with-your-esewa-key
KHALTI_ENV=test
KHALTI_SECRET_KEY=replace-with-your-khalti-key
